# LawRAG Environment Configuration
# Copy this file to .env and fill in the values.
# DO NOT commit your .env file to version control.

# =============================================================================
# Dataset
# =============================================================================
HF_DATASET_ID=dedol-hf/india-case-legal-rag
HF_DATASET_REVISION=cdfb7afa492729eeb4ed39e42b5442ad4748ec71
HF_DATASET_SPLIT=train

# =============================================================================
# Embedding Provider
# =============================================================================
# Provider: "huggingface" (default) or "mock" (for offline testing)
EMBEDDING_PROVIDER=huggingface

# Model confirmed to support HF Inference API feature-extraction
# Dimension: 384  |  Max input: 512 tokens
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# HuggingFace token (required for production; anonymous allowed with rate limits)
# Get yours at: https://huggingface.co/settings/tokens
EMBEDDING_API_KEY=your_hf_token_here

# Batch processing settings
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_DIMENSION=384

# =============================================================================
# Query Rewriting (Optional)
# =============================================================================
# Leave blank to use offline deterministic rewriting
# REWRITER_PROVIDER=openai
# REWRITER_MODEL=gpt-3.5-turbo
# REWRITER_API_KEY=your_openai_key_here
REWRITER_PROVIDER=
REWRITER_MODEL=
REWRITER_API_KEY=
REWRITER_MAX_RETRIES=2

# =============================================================================
# ChromaDB Vector Store
# =============================================================================
# Mode: "local" (default) or "cloud" (for Chroma Cloud / production)
CHROMA_MODE=local
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=lawrag_chunks

# For Chroma Cloud (Phase 3):
# CHROMA_HOST=https://your-instance.cloud.chroma.ai
# CHROMA_API_KEY=your_chroma_api_key

# =============================================================================
# Retrieval Settings
# =============================================================================
TOP_K=5
BM25_TOP_K=10
RRF_K=60
MAX_RETRIEVAL_RETRIES=1

# =============================================================================
# Answer Generation LLM (Phase 2)
# =============================================================================
# Provider: "mock" (offline testing), "groq", "openai", or "huggingface"
LLM_PROVIDER=mock
# Model recommendation: "qwen/qwen3.8-27b" for Groq, "gpt-4o-mini" for OpenAI
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# =============================================================================
# API Server (Phase 3)
# =============================================================================
# FRONTEND_ORIGIN=http://localhost:5173
